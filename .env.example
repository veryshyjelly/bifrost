# Docker Compose interpolation only. Application secrets belong in bridge.env.
COMPOSE_PROJECT_NAME=whatsapp-telegram-bridge
BRIDGE_HTTP_PORT=3210
N8N_HTTP_PORT=5678
# Existing deployment networks; deploy/compose.n8n.yaml creates its own n8n network.
N8N_NETWORK=n8n_default
OPENWA_NETWORK=openwa-network
