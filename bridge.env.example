# Run bun run configure to create bridge.env with fresh secrets, then fill empty account fields.
BRIDGE_ENCRYPTION_KEY=
# Permanent state identity. Keep this value when OpenWA is re-paired or moved.
BIFROST_ACCOUNT_ID=
BRIDGE_ADMIN_TOKEN=
OPENWA_WEBHOOK_SECRET=
OPENWA_URL=http://openwa-api:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=
TELEGRAM_MASTER_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_MANAGEMENT_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://telegram-api:8081
BRIDGE_CALLBACK_URL=http://bifrost:3210
BRIDGE_DB=/data/bridge.db
BRIDGE_MEDIA=/media
# Default count for manual /history requests; /history <n> overrides it (1-2000).
HISTORY_LIMIT=20
MAX_MEDIA_BYTES=104857600
DELIVERY_INTERVAL_MS=1100
SYNC_CRON=0 * * * *
SYNC_TIMEZONE=Asia/Kolkata
COMMAND_TTL_SECONDS=60
CONTROL_TTL_SECONDS=600
