{
  "name": "bifrost",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "export": "bun scripts/transfer.ts export",
    "import": "bun scripts/transfer.ts import",
    "start": "bun --env-file=bridge.env src/server.ts",
    "test": "bun test ./test",
    "test:rewrite": "bun test ./test/rewrite",
    "check:rewrite:oracle": "bun scripts/rewrite/oracle.ts",
    "prepare:rewrite": "bun scripts/rewrite/prepare-context.ts",
    "test:stickers": "STICKER_TESTS=1 bun test --timeout 150000 ./test/stickers.test.ts",
    "check:repository": "bun scripts/check-repository.ts",
    "configure": "bun scripts/configure.ts",
    "setup": "bun --env-file=bridge.env scripts/setup.ts",
    "test:transfer": "BIFROST_DOCKER_TESTS=1 bun test --timeout 150000 ./test/transfer.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "nbb": "1.6.214",
    "puppeteer-core": "25.16.0"
  }
}
